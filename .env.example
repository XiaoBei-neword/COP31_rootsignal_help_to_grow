# ============ 根脉 RootSignal 配置示例 ============
# 复制为 .env 后填写。所有密钥只从这里读，不出现在源码中。

# ---------- Flask ----------
# 留空则自动生成并写入 data/.secret_key
SECRET_KEY=

# ---------- 气象数据 ----------
# auto：按 qweather -> seniverse -> openmeteo -> demo 顺序自动挑选
# 也可强制指定：qweather / seniverse / openmeteo / demo
WEATHER_PROVIDER=auto

# 和风天气（推荐，免费开发版够用）
# 注册后：控制台 → 项目管理 → 创建项目 → 拿到 Key
# 新版账号的 API Host 形如 https://xxxxx.re.qweatherapi.com，请按控制台显示填写
QWEATHER_KEY=
QWEATHER_HOST=https://devapi.qweather.com

# 心知天气（备选）
SENIVERSE_KEY=

# 没有配置任何 Key 时，是否允许回落到「演示数据」。
# 回落时页面顶部会持续显示「当前为演示数据（模拟）」，不会伪装成真实气象。
ALLOW_DEMO_WEATHER=true

# 缓存秒数，避免频繁打接口
WEATHER_CACHE_TTL=900

# ---------- 大模型（任意 OpenAI 兼容接口） ----------
# 预设：deepseek / dashscope / moonshot / zhipu / openai
# 也可以完全不填 provider，直接写 LLM_BASE_URL + LLM_MODEL
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.3

# 大模型调用失败或未配置时，是否允许用本地规则引擎兜底（UI 会标注来源）
ALLOW_RULE_FALLBACK=true
